APP_NAME="AI Visibility"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://your-app-domain.com

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_visibility
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Shopify Partner app credentials (https://partners.shopify.com) ----
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_client_secret
SHOPIFY_APP_SCOPES=read_products,write_products,read_orders,read_themes,write_themes,read_customers,read_locations,read_analytics
SHOPIFY_API_VERSION=2025-04
# Must be a PUBLIC https URL (no trailing slash)
SHOPIFY_APP_HOST_NAME=your-app-domain.com
# App Proxy subpath prefix configured in the Partner Dashboard
SHOPIFY_APP_PROXY_PREFIX=apps/ai-visibility

# ---- Billing plans (INR, recurring every 30 days) ----
PLAN_GROW_PRICE=999
PLAN_SCALE_PRICE=1999
PLAN_AGENCY_PRICE=4999

# ---- AI tracking ----
# Leave both blank → honest "retrieval proxy" mode (no cost, no keys).
# Add a key → real LLM answer checking per engine.
OPENAI_API_KEY=
GEMINI_API_KEY=


# ---- GA4 Data API (AI traffic -> revenue, optional) ----
# Service account with GA4 Viewer access + ecommerce events enabled.
# Option A: path to the service-account JSON file
#GA4_SERVICE_ACCOUNT=/absolute/path/service-account.json
# Option B: individual values (escape newlines in the key as \n)
#GA4_PROPERTY_ID=
#GA4_CLIENT_EMAIL=
#GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#GA4_SOURCE_REGEX=chatgpt|openai|perplexity|gemini|bard|grok|claude|deepseek|copilot

# ---- SaaS-owner (super admin) area ----
# HTTP Basic credentials for /admin. Leave both empty in local/demo to keep the
# panel open for preview; production REQUIRES both to be set.
#ADMIN_EMAIL=owner@your-app-domain.com
#ADMIN_PASSWORD=change-me-long-random

# Public Shopify App Store listing URL for the marketing "Install" CTA.
#SHOPIFY_APP_STORE_URL=https://apps.shopify.com/ai-visibility
